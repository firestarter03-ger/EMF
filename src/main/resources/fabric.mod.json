{
	"schemaVersion": 1,
	"id": "emf",
	"version": "${version}",
	"name": "Elements More Features",
	"description": "Custom Mod für den Datapack Spielmodus Elements ",
	"authors": [
		"firestarter03"
	],
	"contact": {
		"homepage": "https://fabricmc.net/"
	},
	"license": "CC0-1.0",
	"icon": "assets/emf/emf_icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.fire.emf.ElementsMoreFeatures"
		],
		"client": [
			"net.fire.emf.client.ElementsMoreFeaturesClient"
		],
		"modmenu": [
			"net.fire.emf.client.ModMenuIntegration"
		],
		"fabric-datagen": [
			"net.fire.emf.client.ElementsMoreFeaturesDataGenerator"
		]
	},
